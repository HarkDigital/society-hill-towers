# philly3d: fire lights-bake.service twice a day (see lights-bake.service for install).
# AccuracySec is set on purpose: systemd's default timer accuracy is one minute.
[Unit]
Description=philly3d: bake the BOMA illumination calendar twice a day

[Timer]
OnBootSec=60s
OnUnitActiveSec=12h
AccuracySec=5min
Unit=lights-bake.service

[Install]
WantedBy=timers.target
