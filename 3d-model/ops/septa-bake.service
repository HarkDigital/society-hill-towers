# philly3d: the SEPTA baker as one long-lived process (--loop, every 10 s).
# Install:  cp septa_bake.py /opt/philly3d/  (chmod 755)
#           cp septa-bake.service /etc/systemd/system/
#           systemctl daemon-reload && systemctl enable --now septa-bake.service
# Check:    systemctl status septa-bake ; journalctl -u septa-bake -n 20
#           curl -sI https://philly3d.com/septa.json
#
# Why a loop and not the timer: the baker remembers which SEPTA host answered
# last (www3 vs api.septa.org) only within a process, so a oneshot fired every
# 10 s would pay a full upstream timeout on every bake while the first host is
# down. septa-bake.timer is kept as the oneshot alternative (Type=oneshot,
# no --loop, enable the timer instead of this service).
[Unit]
Description=philly3d: bake SEPTA TransitViewAll to /var/www/philly3d/septa.json every 10 s
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/philly3d/septa_bake.py --loop --interval 10 --out /var/www/philly3d/septa.json
Restart=always
RestartSec=10
Nice=5

[Install]
WantedBy=multi-user.target
