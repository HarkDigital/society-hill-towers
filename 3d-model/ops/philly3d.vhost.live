server {
    listen 80;
    listen [::]:80;
    server_name philly3d.com www.philly3d.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/philly3d;
    }
    location / {
        return 301 https://philly3d.com$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name philly3d.com www.philly3d.com;
    root /var/www/philly3d;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/philly3d.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/philly3d.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # same-origin ADS-B passthrough: the page fetches /adsb, nginx fronts the
    # fixed adsb.fi Philadelphia query — no CORS wall, stale beats empty.
    # ACAO * stays on so the GitHub Pages copy can ride the same passthrough.
    location = /adsb {
        resolver 127.0.0.53 valid=300s ipv6=off;   # runtime DNS: a load-time
        # lookup of this hostname once kept nginx from STARTING (Aug 27 outage:
        # unattended-upgrades restarted nginx while the resolver was mid-restart,
        # nginx -t failed on this line, three sites dark for 9 h). The variable
        # defers resolution to request time; ipv6=off because the box has no v6
        # egress and an AAAA answer would strand the proxy.
        set $adsb_host opendata.adsb.fi;
        proxy_pass https://$adsb_host/api/v2/lat/39.872/lon/-75.241/dist/30;
        proxy_set_header Host opendata.adsb.fi;
        proxy_ssl_server_name on;
        proxy_ssl_name opendata.adsb.fi;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_cache adsb_cache;
        proxy_cache_valid 200 8s;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_hide_header Set-Cookie;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Expose-Headers Date always;
        add_header Cache-Control no-store always;
    }

    # the installable app: nginx has no type for .webmanifest, so name it here
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
    }

    # the Streets Department's closures and paving, baked every 30 min by
    # /opt/philly3d/closures_bake.py (Round 79): 120 s against the bake, ACAO * so the
    # GitHub Pages copy can read it (philly3d.com itself reads it same-origin)
    location = /closures.json {
        gzip_static on;
        add_header Cache-Control "public, max-age=120" always;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Expose-Headers Date always;
    }

    # the Amtrak trains near the city, baked every 30 s by /opt/philly3d/amtrak_bake.py
    # (Round 80): 15 s against the bake, ACAO * for the Pages copy
    location = /amtrak.json {
        gzip_static on;
        add_header Cache-Control "public, max-age=15" always;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Expose-Headers Date always;
    }

    # BOMA Philadelphia's illumination calendar, baked twice a day by
    # /opt/philly3d/bake_lights.py (Round 81): 600 s against the bake, ACAO * for the Pages copy
    location = /lights.json {
        gzip_static on;
        add_header Cache-Control "public, max-age=600" always;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Expose-Headers Date always;
    }

    # SEPTA TransitViewAll, baked every 10 s by /opt/philly3d/septa_bake.py (ops/README section 3):
    # 10 s against the bake; the page treats a t older than 90 s as baker down and falls back
    # to SEPTA itself
    location = /septa.json {
        gzip_static on;
        add_header Cache-Control "public, max-age=10" always;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Expose-Headers Date always;
    }

    # the AIS fleet on the rivers, written every 4 s by /opt/philly3d/ais_relay.py (ops/README
    # section 4): 10 s against the write; the page treats a t older than 60 s as relay down and
    # falls back to its own socket
    location = /ais.json {
        gzip_static on;
        add_header Cache-Control "public, max-age=10" always;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Expose-Headers Date always;
    }

    # the concert placards (ops/concerts_bake.py, every 15 min) and the lightning (ops/lightning_relay.py): readable from the
    # Capacitor app (capacitor://localhost, https://localhost), Round 155
    location = /concerts.json {
        gzip_static on;
        add_header Cache-Control "public, max-age=60" always;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Expose-Headers Date always;
    }
    location = /lightning.json {
        gzip_static on;
        add_header Cache-Control "public, max-age=10" always;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Expose-Headers Date always;
    }

    location / {
        gzip_static on;
        try_files $uri $uri/ =404;
        # the page and the feed files revalidate on every load: with no Cache-Control the
        # browser's heuristic (10% of the file's age) kept serving a stale build for hours
        # after a deploy; the ETag turns repeat loads into cheap 304s
        add_header Cache-Control "no-cache" always;
    }
}
