# philly3d: fire closures-bake.service every 30 min (see closures-bake.service for install).
# AccuracySec is set on purpose: systemd's default timer accuracy is one minute.
[Unit]
Description=philly3d: bake the Streets Department closures every 30 min

[Timer]
OnBootSec=60s
OnUnitActiveSec=30min
AccuracySec=30s
Unit=closures-bake.service

[Install]
WantedBy=timers.target
