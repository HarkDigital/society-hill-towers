# philly3d: one bake of BOMA Philadelphia's Building Illumination Calendar (lights-bake.timer fires it).
# Install:  cp fetch_lights.py bake_lights.py /opt/philly3d/  (chmod 755; the bake imports the fetch)
#           cp lights-bake.service lights-bake.timer /etc/systemd/system/
#           systemctl daemon-reload && systemctl enable --now lights-bake.timer
# Check:    systemctl list-timers lights-bake.timer ; journalctl -u lights-bake -n 5
#           curl -s https://philly3d.com/lights.json | python3 -c 'import json,sys; d=json.load(sys.stdin); print(len(d["rows"]), "rows")'
# Remove:   systemctl disable --now lights-bake.timer ; rm /etc/systemd/system/lights-bake.* ; systemctl daemon-reload
#
# A oneshot on a 12 h timer (the calendar changes a few times a month), no key, no env file.
[Unit]
Description=philly3d: bake the BOMA illumination calendar to /var/www/philly3d/lights.json
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/philly3d
ExecStart=/usr/bin/python3 /opt/philly3d/bake_lights.py --fetch --out /var/www/philly3d/lights.json
Nice=10
ProtectSystem=strict
ReadWritePaths=/var/www/philly3d
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
